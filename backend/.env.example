# Cổng HTTP mà backend lắng nghe. Mặc định 3000 nếu không đặt biến này.
PORT=3000

# Chuỗi kết nối PostgreSQL (Supabase). Đọc bởi
# backend/src/config/database.config.ts và dùng bởi
# backend/src/database/postgres-client.ts (xem docs/DATABASE_ACCESS.md).
# KHÔNG commit giá trị thật (mật khẩu Supabase) vào repository — dòng
# dưới đây chỉ minh hoạ ĐỊNH DẠNG, không phải một kết nối thật.
DATABASE_URL=postgresql://user:password@host:5432/dbname
