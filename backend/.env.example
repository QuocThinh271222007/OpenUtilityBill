# Cổng HTTP mà backend lắng nghe. Mặc định 3000 nếu không đặt biến này.
PORT=3000

# Chuỗi kết nối PostgreSQL (Supabase). Sẽ được dùng khi database được
# tích hợp thực sự ở một task sau (xem database/README.md).
# KHÔNG commit giá trị thật của biến này vào repository.
DATABASE_URL=postgresql://user:password@host:5432/dbname
